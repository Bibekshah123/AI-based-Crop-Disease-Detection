# Backend API base URL.
# Leave empty in local dev — Vite proxies /predict, /health and /auth to the
# backend (see vite.config.js). Set to a full URL for a hosted backend, e.g.
#   VITE_API_BASE_URL=https://your-backend.example.com
VITE_API_BASE_URL=

# Legacy name, still supported as a fallback if VITE_API_BASE_URL is unset.
# VITE_API_URL=
